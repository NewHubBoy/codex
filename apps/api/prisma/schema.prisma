generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  code         String?      @unique
  timezone     String?
  locale       String?
  baseCurrency String?
  status       TenantStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orgUnits OrgUnit[]
  users    User[]
  roles    Role[]
  accounts      Account[]
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  products     Product[]
  quotes       Quote[]
  orders       Order[]
  deliveries   Delivery[]
  tickets      Ticket[]
}

model OrgUnit {
  id        String        @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  code      String?
  type      String?
  path      String?
  status    OrgUnitStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  parent   OrgUnit?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgHierarchy")
  members  UserOrgMembership[]

  @@index([tenantId])
  @@index([parentId])
}

model User {
  id        String     @id @default(uuid())
  tenantId  String
  email     String
  name      String
  status    UserStatus @default(ACTIVE)
  passwordHash     String?
  refreshTokenHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  roles          UserRole[]
  orgMemberships UserOrgMembership[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id        String     @id @default(uuid())
  tenantId  String
  code      String
  name      String
  dataScope DataScope @default(SELF)
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  type        PermissionType @default(ACTION)
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId   String
  roleId   String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model UserOrgMembership {
  userId     String
  orgUnitId  String
  roleInOrg  String?
  createdAt  DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id])
  orgUnit  OrgUnit @relation(fields: [orgUnitId], references: [id])

  @@id([userId, orgUnitId])
}

model Account {
  id              String   @id @default(uuid())
  tenantId        String
  orgUnitId       String?
  ownerId         String?
  status          String   @default("ACTIVE")
  name            String
  type            String?
  industry        String?
  rating          String?
  lifecycleStatus String?
  parentId        String?
  bpId            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  parent  Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  childAccounts Account[] @relation("AccountHierarchy")
  contacts Contact[]
  leads    Lead[]
  opportunities Opportunity[]
  quotes   Quote[]
  orders   Order[]
  tickets  Ticket[]

  @@index([tenantId])
  @@index([parentId])
  @@index([ownerId])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  orgUnitId String?
  ownerId   String?
  status    String   @default("ACTIVE")
  accountId String
  name      String
  title     String?
  email     String?
  phone     String?
  role      String?
  bpId      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  leads   Lead[]
  opportunities Opportunity[]
  quotes  Quote[]
  orders  Order[]
  tickets Ticket[]

  @@index([tenantId])
  @@index([accountId])
  @@index([ownerId])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
}

model Lead {
  id             String   @id @default(uuid())
  tenantId       String
  orgUnitId      String?
  ownerId        String?
  status         String   @default("NEW")
  name           String
  source         String?
  rating         String?
  expectedValue  Float?
  accountId      String?
  contactId      String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  opportunities Opportunity[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
}

model Opportunity {
  id                String   @id @default(uuid())
  tenantId           String
  orgUnitId          String?
  ownerId            String?
  status             String   @default("OPEN")
  name               String
  stage              String
  amount             Float?
  currency           String?
  expectedCloseDate  DateTime?
  probability        Float?
  accountId          String?
  contactId          String?
  leadId             String?
  reasonLost         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  lead     Lead?   @relation(fields: [leadId], references: [id])
  quotes   Quote[]
  orders   Order[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
  @@index([leadId])
}

model Activity {
  id          String   @id @default(uuid())
  tenantId    String
  orgUnitId   String?
  ownerId     String?
  status      String   @default("OPEN")
  type        String?
  subject     String?
  relatedType String?
  relatedId   String?
  dueAt       DateTime?
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([ownerId])
  @@index([relatedType, relatedId])
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String
  orgUnitId String?
  ownerId   String?
  status    String   @default("ACTIVE")
  sku       String?
  name      String
  category  String?
  listPrice Float?
  currency  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  quoteItems QuoteItem[]
  orderItems OrderItem[]

  @@index([tenantId])
  @@index([ownerId])
  @@unique([tenantId, sku])
}

model Quote {
  id            String   @id @default(uuid())
  tenantId      String
  orgUnitId     String?
  ownerId       String?
  status        String   @default("DRAFT")
  number        String
  version       Int      @default(1)
  validFrom     DateTime?
  validTo       DateTime?
  totalAmount   Float?
  currency      String?
  opportunityId String?
  accountId     String?
  contactId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  account     Account?     @relation(fields: [accountId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  items       QuoteItem[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
  @@index([opportunityId])
  @@unique([tenantId, number])
}

model QuoteItem {
  id        String   @id @default(uuid())
  quoteId   String
  productId String?
  qty       Float?
  unitPrice Float?
  discount  Float?
  tax       Float?
  lineTotal Float?
  createdAt DateTime @default(now())

  quote   Quote    @relation(fields: [quoteId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
}

model Order {
  id            String   @id @default(uuid())
  tenantId      String
  orgUnitId     String?
  ownerId       String?
  status        String   @default("DRAFT")
  number        String
  orderDate     DateTime?
  totalAmount   Float?
  currency      String?
  accountId     String?
  contactId     String?
  opportunityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  account     Account?     @relation(fields: [accountId], references: [id])
  contact     Contact?     @relation(fields: [contactId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  items       OrderItem[]
  deliveries  Delivery[]
  tickets     Ticket[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
  @@index([opportunityId])
  @@unique([tenantId, number])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  qty       Float?
  unitPrice Float?
  discount  Float?
  tax       Float?
  lineTotal Float?
  createdAt DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Delivery {
  id           String   @id @default(uuid())
  tenantId     String
  orgUnitId    String?
  ownerId      String?
  status       String   @default("PLANNED")
  number       String
  orderId      String?
  deliveredAt  DateTime?
  deliveryNotes String?
  deliveredQty Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([ownerId])
  @@index([orderId])
  @@unique([tenantId, number])
}

model Ticket {
  id        String   @id @default(uuid())
  tenantId  String
  orgUnitId String?
  ownerId   String?
  status    String   @default("NEW")
  number    String
  type      String?
  priority  String?
  subject   String?
  slaDueAt  DateTime?
  accountId String?
  contactId String?
  orderId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
  @@index([orderId])
  @@unique([tenantId, number])
}

model NumberRange {
  id           String   @id @default(uuid())
  tenantId     String
  objectType   String
  prefix       String?
  currentValue Int      @default(0)
  format       String?
  resetRule    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, objectType])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  actorId   String?
  action    String
  objectType String
  objectId  String
  summary   String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([objectType, objectId])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  tenantId      String
  aggregateType String
  aggregateId   String
  eventType     String
  payloadJson   Json
  status        OutboxStatus @default(PENDING)
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([status])
}

model ProcessDefinition {
  id        String   @id @default(uuid())
  tenantId  String
  entityType String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states      ProcessState[]
  transitions ProcessTransition[]

  @@index([tenantId])
  @@unique([tenantId, entityType, name])
}

model ProcessState {
  id          String   @id @default(uuid())
  processId   String
  stateKey    String
  displayName String
  category    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  process ProcessDefinition @relation(fields: [processId], references: [id])

  @@index([processId])
  @@unique([processId, stateKey])
}

model ProcessTransition {
  id            String   @id @default(uuid())
  processId     String
  fromState     String
  toState       String
  conditionExpr String?
  requiredRoles String?
  createdAt     DateTime @default(now())

  process ProcessDefinition @relation(fields: [processId], references: [id])

  @@index([processId])
}

model FieldDefinition {
  id           String   @id @default(uuid())
  tenantId     String
  entityType   String
  fieldKey     String
  label        String
  dataType     String
  required     Boolean  @default(false)
  optionsJson  Json?
  validationJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, entityType, fieldKey])
}

model FieldGroup {
  id         String   @id @default(uuid())
  tenantId   String
  entityType String
  groupName  String
  sortOrder  Int      @default(0)
  layoutJson Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionType {
  PAGE
  ACTION
  DATA
}

enum DataScope {
  SELF
  TEAM
  SUBTREE
  ALL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}
