generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  code         String?      @unique
  timezone     String?
  locale       String?
  baseCurrency String?
  status       TenantStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orgUnits OrgUnit[]
  users    User[]
  roles    Role[]
  accounts      Account[]
  contacts      Contact[]
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
}

model OrgUnit {
  id        String        @id @default(uuid())
  tenantId  String
  parentId  String?
  name      String
  code      String?
  type      String?
  path      String?
  status    OrgUnitStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  parent   OrgUnit?  @relation("OrgHierarchy", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgHierarchy")
  members  UserOrgMembership[]

  @@index([tenantId])
  @@index([parentId])
}

model User {
  id        String     @id @default(uuid())
  tenantId  String
  email     String
  name      String
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  roles          UserRole[]
  orgMemberships UserOrgMembership[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id        String     @id @default(uuid())
  tenantId  String
  code      String
  name      String
  dataScope DataScope @default(SELF)
  status    RoleStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  type        PermissionType @default(ACTION)
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId   String
  roleId   String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model UserOrgMembership {
  userId     String
  orgUnitId  String
  roleInOrg  String?
  createdAt  DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id])
  orgUnit  OrgUnit @relation(fields: [orgUnitId], references: [id])

  @@id([userId, orgUnitId])
}

model Account {
  id              String   @id @default(uuid())
  tenantId        String
  orgUnitId       String?
  ownerId         String?
  status          String   @default("ACTIVE")
  name            String
  type            String?
  industry        String?
  rating          String?
  lifecycleStatus String?
  parentId        String?
  bpId            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  parent  Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  childAccounts Account[] @relation("AccountHierarchy")
  contacts Contact[]
  leads    Lead[]
  opportunities Opportunity[]

  @@index([tenantId])
  @@index([parentId])
  @@index([ownerId])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  orgUnitId String?
  ownerId   String?
  status    String   @default("ACTIVE")
  accountId String
  name      String
  title     String?
  email     String?
  phone     String?
  role      String?
  bpId      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  account Account @relation(fields: [accountId], references: [id])
  leads   Lead[]
  opportunities Opportunity[]

  @@index([tenantId])
  @@index([accountId])
  @@index([ownerId])
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
}

model Lead {
  id             String   @id @default(uuid())
  tenantId       String
  orgUnitId      String?
  ownerId        String?
  status         String   @default("NEW")
  name           String
  source         String?
  rating         String?
  expectedValue  Float?
  accountId      String?
  contactId      String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  opportunities Opportunity[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
}

model Opportunity {
  id                String   @id @default(uuid())
  tenantId           String
  orgUnitId          String?
  ownerId            String?
  status             String   @default("OPEN")
  name               String
  stage              String
  amount             Float?
  currency           String?
  expectedCloseDate  DateTime?
  probability        Float?
  accountId          String?
  contactId          String?
  leadId             String?
  reasonLost         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  lead     Lead?   @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([contactId])
  @@index([leadId])
}

model Activity {
  id          String   @id @default(uuid())
  tenantId    String
  orgUnitId   String?
  ownerId     String?
  status      String   @default("OPEN")
  type        String?
  subject     String?
  relatedType String?
  relatedId   String?
  dueAt       DateTime?
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([ownerId])
  @@index([relatedType, relatedId])
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionType {
  PAGE
  ACTION
  DATA
}

enum DataScope {
  SELF
  TEAM
  SUBTREE
  ALL
}
